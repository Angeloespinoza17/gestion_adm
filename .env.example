# URL y cookies de la aplicacion
# Desarrollo local. APP_TRUSTED_HOSTS acepta solo hosts exactos, sin esquema,
# ruta ni comodines. SESSION_DOMAIN vacio mantiene la cookie ligada al host.
APP_URL=http://127.0.0.1:8000
APP_TRUSTED_HOSTS=localhost
ASSET_URL=
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8000,localhost:8000

# Produccion (reemplace el bloque local anterior con estos valores):
# APP_URL=https://cnscvaldivia.cl
# APP_TRUSTED_HOSTS=www.cnscvaldivia.cl,cnscgestion.cl,www.cnscgestion.cl
# ASSET_URL=https://cnscvaldivia.cl
# SESSION_DOMAIN=
# SESSION_SECURE_COOKIE=true
# SANCTUM_STATEFUL_DOMAINS=cnscvaldivia.cl,www.cnscvaldivia.cl

# Mensajeria interna y operacion asincrona
# El ejemplo falla cerrado: habilite el modulo y Reverb solo despues de
# comprobar workers, proxy TLS, canales privados y recuperacion HTTP.
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids
BROADCAST_DRIVER=null

MESSAGING_ENABLED=false
MESSAGING_REALTIME_ENABLED=false
MESSAGING_REALTIME_GRACE_MS=10000
MESSAGING_HTTP_FALLBACK_ENABLED=true
MESSAGING_POLL_INTERVAL_MS=60000
MESSAGING_ACTIVE_POLL_INTERVAL_MS=30000
MESSAGING_MAX_POLL_INTERVAL_MS=120000
MESSAGING_RECONCILIATION_INTERVAL_MS=300000
MESSAGING_POLL_JITTER_RATIO=0.20
MESSAGING_RECOVERY_LIMIT=100
MESSAGING_EDIT_WINDOW_MINUTES=15
MESSAGING_MAX_MESSAGE_LENGTH=20000
MESSAGING_MAX_ATTACHMENTS_PER_MESSAGE=10
MESSAGING_MAX_ATTACHMENT_MB=20
MESSAGING_FILESYSTEM_DISK=local

# Reverb local. Genere credenciales diferentes para cada entorno y no las
# confirme en Git. REVERB_ALLOWED_ORIGINS contiene hosts, no URL completas.
REVERB_SERVER=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_SERVER_PATH=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=127.0.0.1,localhost
REVERB_MAX_REQUEST_SIZE=10000
REVERB_APP_MAX_MESSAGE_SIZE=10000
REVERB_APP_MAX_CONNECTIONS=250
REVERB_APP_PING_INTERVAL=60
REVERB_APP_ACTIVITY_TIMEOUT=30
REVERB_APP_ACCEPT_CLIENT_EVENTS_FROM=none
REVERB_APP_RATE_LIMITING_ENABLED=true
REVERB_APP_RATE_LIMIT_MAX_ATTEMPTS=120
REVERB_APP_RATE_LIMIT_DECAY_SECONDS=60
REVERB_APP_RATE_LIMIT_TERMINATE=false
REVERB_SCALING_ENABLED=false

# Estas variables son publicas y se incorporan al bundle. Nunca exponga
# REVERB_APP_SECRET ni otra credencial privada con el prefijo VITE_.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Binarios remotos requeridos por scripts/deploy.sh en el VPS actual
DEPLOY_PHP_BIN=/opt/cpanel/ea-php83/root/usr/bin/php
DEPLOY_COMPOSER_BIN="/opt/cpanel/ea-php83/root/usr/bin/php /usr/local/bin/composer"

# Canva Connect API
CANVA_ENABLED=false
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI="${APP_URL}/api/integraciones/canva/callback"
CANVA_SCOPES="design:content:write design:meta:read brandtemplate:meta:read brandtemplate:content:read profile:read"
CANVA_AUTHORIZE_URL=https://www.canva.com/api/oauth/authorize
CANVA_API_BASE_URL=https://api.canva.com/rest/v1
CANVA_CONNECT_TIMEOUT=8
CANVA_TIMEOUT=30
CANVA_OAUTH_STATE_TTL_MINUTES=10
CANVA_TOKEN_REFRESH_LEEWAY_SECONDS=300
CANVA_TEMPLATE_CACHE_SECONDS=300
CANVA_AUTOFILL_POLL_SECONDS=5
CANVA_AUTOFILL_DEADLINE_MINUTES=15
CANVA_MAX_FIELD_CHARACTERS=5000

# Preview only for local/testing. Leave false in every deployed environment;
# Canva Enterprise Autofill does not need this fallback.
CANVA_AUTOFILL_TRIAL_ENABLED=false

# Pronóstico meteorológico diario de Valdivia (solo servidor)
WEATHERAPI_KEY=
WEATHERAPI_FORECAST_DAYS=7
WEATHERAPI_DISPLAY_DAYS=7
