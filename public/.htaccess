<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Canonical production host. Keep the original path and query string while
    # permanently moving the legacy domain and both www aliases to the new apex.
    RewriteCond %{HTTP_HOST} ^(?:www\.)?cnscgestion\.cl$ [NC,OR]
    RewriteCond %{HTTP_HOST} ^www\.cnscvaldivia\.cl$ [NC]
    RewriteRule ^ https://cnscvaldivia.cl%{REQUEST_URI} [R=308,L]

    # Force HTTPS on the canonical apex. Cloudflare connects to this origin
    # over HTTPS, so never trust a client-supplied forwarded-proto header here.
    RewriteCond %{HTTP_HOST} ^cnscvaldivia\.cl$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://cnscvaldivia.cl%{REQUEST_URI} [R=308,L]

    # Ensure Authorization header reaches PHP under CGI/FastCGI.
    <IfModule mod_core.c>
        CGIPassAuth On
    </IfModule>

    <IfModule mod_setenvif.c>
        SetEnvIfNoCase Authorization "(.+)" HTTP_AUTHORIZATION=$1
    </IfModule>

    # Legacy Convivencia attachments must only be served through the
    # authenticated download controller. Keep this rule before the generic
    # static-file bypass so existing files under public/storage are denied.
    RewriteRule ^storage/convivencia(?:/|$) - [F,L,NC]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/plain text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml font/woff font/woff2
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml font/woff font/woff2
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 hour"
    ExpiresByType application/javascript "access plus 1 hour"
    ExpiresByType image/jpeg "access plus 7 days"
    ExpiresByType image/png "access plus 7 days"
    ExpiresByType image/webp "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 7 days"
    ExpiresByType video/mp4 "access plus 7 days"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/build/(js|assets)/.+-[A-Za-z0-9_-]{8,}\.(js|css|woff|woff2)$" immutable_asset=1
</IfModule>

<IfModule mod_headers.c>
    Header append Vary Accept-Encoding
    Header set Cache-Control "public, max-age=31536000, immutable" env=immutable_asset
</IfModule>
